<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext denied globally; the known Tailscale peer is an exact-host exception. -->
    <base-config cleartextTrafficPermitted="false" />
    <!-- Kotlin transport also requires active VPN and exactly port 8000 for tailnet. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">100.105.213.95</domain>
    </domain-config>
</network-security-config>
