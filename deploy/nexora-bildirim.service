[Unit]
Description=NEXORA bildirim taramasi (salt okunur kaynaklar; yalnizca bildirim kaydi, emir yok)
After=network-online.target

[Service]
Type=oneshot
User=nexora
WorkingDirectory=/opt/nexora/backend
EnvironmentFile=/etc/nexora.env
ExecStart=/usr/bin/python3 -u bildirim_tara.py
TimeoutStartSec=300
Nice=10
