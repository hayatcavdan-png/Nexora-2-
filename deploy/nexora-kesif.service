[Unit]
Description=NEXORA gunluk otomatik cuzdan kesfi (Solana: oneri; EVM paper: yalniz kopyalanabilirler eklenir)
After=network-online.target

[Service]
Type=oneshot
User=nexora
WorkingDirectory=/opt/nexora/backend
EnvironmentFile=/etc/nexora.env
ExecStart=/usr/bin/python3 -u otomatik_kesif.py
TimeoutStartSec=3600
Nice=10
