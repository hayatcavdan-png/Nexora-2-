[Unit]
Description=NEXORA gunluk otomatik cuzdan kesfi (yalniz oneri; takip listesine dokunmaz)
After=network-online.target

[Service]
Type=oneshot
User=nexora
WorkingDirectory=/opt/nexora/backend
EnvironmentFile=/etc/nexora.env
ExecStart=/usr/bin/python3 -u otomatik_kesif.py
TimeoutStartSec=1800
Nice=10
