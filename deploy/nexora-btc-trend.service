[Unit]
Description=NEXORA BTC günlük trend motoru (PAPER: SMA100 uzun/nakit, cbBTC sanal al/sat; BTC_TREND=1 olmadan hiçbir şey yapmaz)

[Service]
Type=oneshot
User=nexora
WorkingDirectory=/opt/nexora/backend
EnvironmentFile=/etc/nexora.env
ExecStart=/usr/bin/python3 -u -m nexora.btc_trend_motor
TimeoutStartSec=300
